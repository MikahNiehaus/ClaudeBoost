# .ragignore — directories excluded from rag_index_project for this project
# Same syntax as .gitignore: one entry per line, # for comments, trailing / optional.
# Entries match directory *names* (not full paths) during file discovery.

# Playwright MCP page captures — not source code
.playwright-mcp/

# Benchmark datasets in mcp-rag-server/tests/data/ — 21k+ files, not source code
data/

# Project KB research docs — searchable via knowledge/project KB tier, not codebase search
.claudeboost/

# Scripts that are generated or vendored (add more as needed)
# example: vendor/
