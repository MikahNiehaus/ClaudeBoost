{
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(python \"$CLAUDEBOOST_HOME/scripts/*.py\"*)",
      "Bash(python3 \"$CLAUDEBOOST_HOME/scripts/*.py\"*)",
      "Bash(sqlite3 \"C:/Development/*/workspace/.rag-index/graph.db\" *)",
      "Bash(rm -f \"$CLAUDEBOOST_HOME/state/*.json\")",
      "Bash(rm -f \"$TEMP/claudeboost_*\")",
      "Bash(grep *)",
      "Bash(ls *)",
      "Bash(wc *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(cat *)",
      "Bash(find *)",
      "Bash(mkdir *)"
    ],
    "ask": [
      "Bash(echo *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDEBOOST_HOME/scripts/rag-session-reset.py\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDEBOOST_HOME/scripts/reindex-check.py\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDEBOOST_HOME/scripts/compaction-restore.py\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDEBOOST_HOME/scripts/session-primer.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__rag-server__",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDEBOOST_HOME/scripts/rag-error-guard.py\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDEBOOST_HOME/scripts/context-nudge.py\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDEBOOST_HOME/scripts/compaction-save.py\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDEBOOST_HOME/scripts/compaction-primer.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDEBOOST_HOME/scripts/rag-agent-guard.py\""
          }
        ]
      },
      {
        "matcher": "Bash(mkdir*workspace*)",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDEBOOST_HOME/scripts/workspace-boost-gate.py\""
          }
        ]
      },
      {
        "matcher": "Grep",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDEBOOST_HOME/scripts/rag-read-guard.py\""
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDEBOOST_HOME/scripts/rag-read-guard.py\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDEBOOST_HOME/scripts/session-clear-save.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDEBOOST_HOME/scripts/stop-context-guard.py\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDEBOOST_HOME/scripts/human-voice-guard.py\""
          }
        ]
      }
    ]
  }
}
