{
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(python \"$CLAUDEBOOST_HOME/scripts/*.py\")",
      "Bash(python -c *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDEBOOST_HOME/scripts/reindex-check.py\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDEBOOST_HOME/scripts/compaction-restore.py\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDEBOOST_HOME/scripts/session-primer.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__rag-server__",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDEBOOST_HOME/scripts/rag-error-guard.py\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDEBOOST_HOME/scripts/context-nudge.py\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDEBOOST_HOME/scripts/compaction-save.py\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDEBOOST_HOME/scripts/compaction-primer.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDEBOOST_HOME/scripts/rag-agent-guard.py\""
          }
        ]
      },
      {
        "matcher": "Bash(mkdir*workspace*)",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDEBOOST_HOME/scripts/workspace-boost-gate.py\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDEBOOST_HOME/scripts/session-clear-save.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDEBOOST_HOME/scripts/stop-context-guard.py\""
          }
        ]
      }
    ]
  }
}
