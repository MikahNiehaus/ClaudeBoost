{
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(grep **)",
      "Bash(ls **)",
      "Bash(wc **)",
      "Bash(head **)",
      "Bash(tail **)",
      "Bash(cat **)",
      "Bash(find **)",
      "Bash(mkdir **)",
      "Bash(echo **)",
      "Bash(python -m pytest *)",
      "Bash(curl -s http://127.0.0.1:8613*)",
      "Bash(curl -s -X POST http://127.0.0.1:8613*)",
      "Bash(curl -X POST http://127.0.0.1:8613*)",
      "Bash(curl http://127.0.0.1:8613*)"
    ],
    "ask": [
      "Bash(sqlite3 *)",
      "Bash(sqlite3)",
      "Edit(**/.claude/browser-targets.local.json)",
      "Write(**/.claude/browser-targets.local.json)",
      "Edit(**/.claude/browser-targets.example.json)",
      "Write(**/.claude/browser-targets.example.json)",
      "Edit(**/.claude/redacted-terms.local.json)",
      "Write(**/.claude/redacted-terms.local.json)",
      "Edit(**/scripts/bash-guard.py)",
      "Write(**/scripts/bash-guard.py)",
      "Edit(**/clean-rag/hooks/**)",
      "Write(**/clean-rag/hooks/**)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDEBOOST_PYTHON\" \"$CLAUDEBOOST_HOME/scripts/reindex-check.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDEBOOST_PYTHON\" \"$CLAUDEBOOST_HOME/scripts/compaction-save.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDEBOOST_PYTHON\" \"$CLAUDEBOOST_HOME/scripts/compaction-primer.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Grep",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDEBOOST_PYTHON\" \"$CLAUDEBOOST_HOME/scripts/rag-read-guard.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDEBOOST_PYTHON\" \"$CLAUDEBOOST_HOME/scripts/rag-read-guard.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDEBOOST_PYTHON\" \"$CLAUDEBOOST_HOME/scripts/stop-context-guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
