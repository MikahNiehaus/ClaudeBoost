# clean-rag configuration.
#
# Copy this to clean-rag/.env and edit. The real .env is gitignored, so each
# machine keeps its own. Every value here is a default, so a key you don't set
# just uses the default baked into server/config.py.
#
# Precedence, highest wins:
#   real env vars (settings.json)  >  clean-rag/.env  >  ClaudeBoost/.env  >  defaults
# So anything set in ~/.claude/settings.json still overrides this file, and
# clean-rag/.env overrides a shared ClaudeBoost/.env one directory up.

# Where clean-rag lives. Usually left unset (derived from the file location).
# CLEAN_RAG_HOME=

# Server port. 8613 standalone.
CLEAN_RAG_PORT=8613

# Embedding model for project code indexing. Change only if you know why.
# CLEAN_RAG_CODE_EMBEDDING_MODEL=flax-sentence-embeddings/st-codesearch-distilroberta-base

# Device for embeddings: cuda, cpu, or blank to autodetect.
# CLEAN_RAG_DEVICE=

# Chunking.
CLEAN_RAG_CHUNK_OVERLAP=50
CLEAN_RAG_EMBED_BATCH_SIZE=32

# Web search fallback (DuckDuckGo, no API key).
CLEAN_RAG_WEB_SEARCH=true
CLEAN_RAG_WEB_SEARCH_TIMEOUT=4.0
CLEAN_RAG_WEB_SEARCH_MAX_RESULTS=3
CLEAN_RAG_WEB_SEARCH_THRESHOLD=0.4

# Research gate mode. "stop" batches checking once per turn.
CLEAN_RAG_GATE_MODE=stop

# Pre edit pattern injection.
CLEAN_RAG_PATTERN_INJECT=true
