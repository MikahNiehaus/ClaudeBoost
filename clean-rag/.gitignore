# Cloned documentation (large, regenerated by install --seed)
knowledge/

# ChromaDB indexes (regenerated by indexing)
databases/

# Runtime state (logs, proofs, registry)
state/proof-log.jsonl
state/pending-proof-*.json
state/pending-proof-*.consumed
state/server.json
state/telemetry.jsonl
state/debug-mode.json
state/debug-fix-required.json
state/*.log

# Isolated venvs for heavy/conflicting dependencies (torch, transformers).
# Confirmed this session: installing these in the shared Python env breaks
# other projects' pinned versions (open-webui's pyarrow==20.0.0). Each
# machine builds its own via install.py, never committed.
.venv-router/
.venv-coref/
graphrag-venv/
clean-rag-venv/

# Local AI models for the GraphRAG extraction service (GGUF and friends). Large,
# machine specific, never committed. Each machine provides its own model file.
*.gguf
*.ggml
*.safetensors
models/
graphrag-models/

# Machine specific config. Each checkout keeps its own. The committed template
# is .env.example.
.env
.env.*
!.env.example

# Configured doc-rag source lists name whatever topic you're personally
# researching (medical debt law, or anything else), never committed. The
# tracked template documents the schema for a fresh clone.
docs_sources/*.json
!docs_sources/*.template.json

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
