/* ClaudeBoost Changes HUD - Sci-fi HUD theme */

Screen {
    background: #0a0a0a;
    color: #00ff41;
}

Header {
    background: #0a0a0a;
    color: #00ff41;
}

Footer {
    background: #0d0d0d;
    color: #005500;
}

#summary {
    height: auto;
    max-height: 5;
    border: double #00ff41;
    padding: 0 1;
    margin: 0 0 1 0;
    background: #0d0d0d;
}

#scan-screen {
    width: 100%;
    height: 100%;
    background: #0a0a0a;
    color: #00ff41;
}

#file-tree {
    height: 1fr;
    margin: 0 1;
    background: #0a0a0a;
    color: #00cc33;
}

#file-tree > .tree--cursor {
    background: #002200;
    color: #00ff41;
}

#file-tree > .tree--highlight {
    background: #001a00;
}

#file-tree > .tree--guides {
    color: #003300;
}

#diff-view {
    height: 1fr;
    margin: 0 1;
    background: #0a0a0a;
}

#diff-scroll {
    height: 1fr;
    background: #0a0a0a;
}

#diff-log {
    background: #0a0a0a;
    padding: 1 2;
}

Scrollbar {
    background: #0d0d0d;
    color: #003300;
}

ScrollbarSlider {
    color: #00ff41 30%;
}

ScrollbarSlider:hover {
    color: #00ff41 60%;
}
